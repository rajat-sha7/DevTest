# Public URL of the deployed site. Used for canonical URLs, the sitemap,
# robots.txt, structured data and social share cards.
NEXT_PUBLIC_SITE_URL=https://devqna.online

# Optional: search console ownership tokens (content value of the meta tag only).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Server-only: Groq API keys for the AI deep-dive and the Hindi "Listen" translation.
# Up to three keys; the next one is tried when one is rate-limited.
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
